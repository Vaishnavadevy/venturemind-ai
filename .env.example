# Shared local-development settings. Copy to .env and replace placeholders.
APP_ENV=development
LOG_LEVEL=INFO

# Database (backend module will consume these variables)
MYSQL_DATABASE=venturemind
MYSQL_USER=venturemind
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-too
DATABASE_URL=mysql+pymysql://venturemind:change-me@db:3306/venturemind

# Security
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# AI providers
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Frontend
VITE_API_BASE_URL=http://localhost:8000/api/v1
